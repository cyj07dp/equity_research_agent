{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Agent Service (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--app-dir",
        "src",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/agent-service",
      "python": "${workspaceFolder}/agent-service/.venv-equity-research-agent/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/agent-service/src"
      },
      "jinja": true,
      "justMyCode": false
    },
    {
      "name": "Python Agent Service Tests (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}"
      ],
      "cwd": "${workspaceFolder}/agent-service",
      "python": "${workspaceFolder}/agent-service/.venv-equity-research-agent/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/agent-service/src"
      },
      "justMyCode": false
    }
  ]
}
